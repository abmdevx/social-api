# ==========================
# Server
# ==========================
NODE_ENV=development
PORT=8000
# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs / rate limits.
TRUST_PROXY=0
LOG_LEVEL=info

# ==========================
# Database
# ==========================
# Connection string WITHOUT a database name; the database is chosen by DB_NAME.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=streamline

# ==========================
# Client / CORS / cookies
# ==========================
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
# lax works when frontend and API share a site (also localhost:5173 -> localhost:8000).
# Use "none" only in production with HTTPS when they are on different sites.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ==========================
# JWT authentication (secrets: at least 32 characters, and different from each other)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# ==========================
# Cloudinary
# ==========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================
# Uploads (optional)
# ==========================
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100
# UPLOAD_TMP_DIR=

# ==========================
# Rate limiting (optional)
# ==========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ==========================
# API docs (Swagger UI at /api-docs). Defaults to on in development, off in production.
# ==========================
# ENABLE_API_DOCS=true
