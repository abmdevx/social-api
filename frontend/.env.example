# Leave empty to use the same-origin default "/api/v1" (served by the Vite proxy in development).
# Set to the full API URL when the API lives on another origin, e.g. https://api.example.com/api/v1
VITE_API_URL=
# Where the Vite dev proxy forwards /api (development only).
VITE_DEV_API_TARGET=http://localhost:8000
